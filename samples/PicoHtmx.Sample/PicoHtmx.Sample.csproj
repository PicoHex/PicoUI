<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- PicoWeb pulls PicoJetson into the graph; its source generator
         requires AllowUnsafeBlocks (same as the PicoHtmx module). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoHtmx\PicoHtmx.csproj" />
  </ItemGroup>
  <!-- Cross-repo dependency: consumed as a published package only (no sibling
       source switching — cross-repo deps never build another repo's sources). -->
  <ItemGroup>
    <PackageReference Include="PicoWeb" />
  </ItemGroup>
</Project>
