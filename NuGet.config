<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local PicoUI feed — release staging + sibling-repo consumption
         during the nuget.org indexing gap -->
        <!-- Relative to this file: valid on dev machines AND CI runners -->
    <add key="local" value="artifacts/nupkg" />
  </packageSources>
</configuration>