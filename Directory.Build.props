<Project>
  <!-- ═══════════════════════════════════════════════════════
       PicoUI shared build properties
       ═══════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- Default version for local / non-CI builds -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <!-- Central Package Management. The CPM switches themselves
         (ManagePackageVersionsCentrally, CentralPackageFloatingVersionsEnabled,
         CentralPackageTransitivePinningEnabled) live in Directory.Packages.props,
         next to the versions they govern. Declaring this one here as well gave
         one property two sources of truth, and only the later import won. -->

    <!-- Lock files pin the resolved graph so the y-floating versions in
         Directory.Packages.props (2026.<x>.*) stay reproducible: a restore that
         would move a floating or transitive dependency fails instead of drifting
         silently. CI restores with -p:RestoreLockedMode=true; deps-refresh.yml
         re-evaluates the lock weekly and opens a PR when it moves.
         Every project this file governs is in this repository: cross-repo
         dependencies arrive as packages, so the locks describe the whole
         resolved graph — there is no out-of-repository project that would
         evaluate another Directory.Build.props and escape them. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Never bake an implicit publish RID into the lock files. The SDK
         defaults the publish RuntimeIdentifier to the host's as soon as a
         project turns PublishAot on, so a lock refreshed that way records the
         RID of the machine that refreshed it and every other leg of the CI
         matrix then fails NU1004 (the project's runtime identifiers have
         changed). With the default off, RuntimeIdentifiers stays empty unless
         a RID is asked for, and each publish in .github/workflows/ci.yml asks
         for one explicitly, which restores that RID's assets on demand. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>

    <!-- Deterministic builds when CI=true -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Analyzer + style enforcement, warnings as errors -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Symbol packages for NuGet.org debugging experience -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Default: use project references for local dev.
         Scope: THIS repository only (PicoMarkdown/PicoMermaid source vs. package
         for PicoTui and friends). Cross-repo dependencies (PicoNode) are
         package-only — see src/PicoHtmx/PicoHtmx.csproj. -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>

    <!-- Cross-repo dependencies are consumed as published packages, always.
         There is deliberately no sibling-repo detection here: building another
         repository's sources from this one made `dotnet build PicoUI.slnx`
         silently ignore this repo's own package versions. -->

    <!-- Default: don't pack unless opted in -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <!-- PicoJetson (≥ 2026.4) generates unsafe code paths; the PicoUI
         modules that serialize with it require the flag. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════
       NuGet package icon (the PicoHex family logo)

       The two halves below are a pair and must stay together: PackageIcon
       names the entry inside the package, the None item actually puts the
       file there at the package root. Remove either one and `dotnet pack`
       fails with NU5046 (the icon file does not exist in the package).

       $(MSBuildThisFileDirectory) resolves against THIS file, so the icon is
       always the repository root icon.png, no matter how deep the packing
       project sits. Guarding the item on IsPackable is safe in a props file:
       MSBuild evaluates every item in a pass after every property, so the
       condition already sees the value the csproj body declares.

       PNG here and not the SVG the READMEs use: PackageIcon accepts only PNG
       and JPG. The vector logo lives at assets/picohex.svg.

       (No literal double hyphen appears above: XML comments may not contain
       one, and a props file that does not parse loses every property it
       declares, which surfaces as NU1015, not as a syntax error.)
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
