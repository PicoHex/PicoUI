<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <!-- PicoJetson's source generator requires AllowUnsafeBlocks for
         anonymous-type analysis (same consumer requirement). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>PicoHtmx</PackageId>
    <RootNamespace>PicoHtmx</RootNamespace>
    <Description>HTML + HTMX toolkit for PicoWeb — AOT-safe HTML builder, HTMX response helpers, and server-rendered UI components.</Description>
    <PackageTags>PicoHex;PicoHtmx;HTMX;HTML;AOT;Web</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <!-- Cross-repo reference: PicoNode.Http + PicoNode.Web (network/web layers).
       Sibling project refs when the PicoNode repo is checked out next to this
       one (local dev / CI); published packages otherwise.
       NOTE: deliberately NOT PicoWeb — its package props inject source
       generators into every consumer (a placeholder EndpointRegistrar is
       emitted even for libraries with zero controllers, CS0436 in library
       consumers). PicoHtmx only needs the HTTP + Web layers. Upstream
       follow-up (PicoNode): Controllers.Gen should emit nothing for empty
       controller sets. -->
  <ItemGroup Condition="'$(UseSiblingProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\PicoNode\src\Http\PicoNode.Http\PicoNode.Http.csproj" />
    <ProjectReference Include="..\..\..\PicoNode\src\Web\PicoNode.Web\PicoNode.Web.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseSiblingProjectReferences)' != 'true'">
    <PackageReference Include="PicoNode.Http" />
    <PackageReference Include="PicoNode.Web" />
  </ItemGroup>
  <ItemGroup>
    <!-- Direct PicoJetson use (JsonWriter in HtmxEvents); was previously a
         transitive ref through PicoWeb. -->
    <PackageReference Include="PicoJetson" />
  </ItemGroup>
</Project>